<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>muse-md</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="centralLayout">
    <item>
     <widget class="EditorWorkbench" name="workbench">
      <property name="orientation">
       <enum>Qt::Horizontal</enum>
      </property>
      <property name="childrenCollapsible">
       <bool>false</bool>
      </property>
      <!-- 中央区是一台"工作台"（我们自己的 QSplitter 子类）：左右分屏、三种显示模式、
           以及编辑器与预览之间的双向同步都归它管。.ui 只描述"左边放编辑器容器、
           右边放预览"这个结构，行为都在 EditorWorkbench 里。 -->
      <!-- 左边是多标签管理器（每个标签里是一个 EditorWidget，由 TabManager 在代码里创建）；
           编辑器不在 .ui 里，因为"有几个"是运行期才知道的。 -->
      <widget class="TabManager" name="tabManager">
       <property name="tabsClosable">
        <bool>true</bool>
       </property>
       <property name="movable">
        <bool>true</bool>
       </property>
      </widget>
      <widget class="QWebEngineView" name="preview">
       <property name="url">
        <url>
         <string>about:blank</string>
        </url>
       </property>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar"/>
  <widget class="QStatusBar" name="statusbar"/>
  <!-- 左侧停靠面板：文件树。
       做成 QDockWidget 之后它就可以被拖到任意停靠区、也能关掉（菜单「视图 → 文件树」或
       「显示/隐藏侧边栏」开关）；中央区因此回到"两栏"（编辑器 + 预览），
       分屏比例也就不再需要照顾第三块。 -->
  <widget class="QDockWidget" name="fileTreeDock">
   <property name="windowTitle">
    <string>文件</string>
   </property>
   <attribute name="dockWidgetArea">
    <number>1</number>
   </attribute>
   <widget class="FileTreeView" name="fileTree"/>
  </widget>
  <!-- 左侧停靠面板：大纲（C4）。
       和文件树**叠在同一个停靠区**（tabifyDockWidget 在 initUi() 里做），底部多一个
       页签来切换"文件 / 大纲"—— 不新开一列，三栏布局（侧栏 + 编辑器 + 预览）一点没动。
       放左侧而不是右侧/底部：右侧和预览抢地方（预览是核心），底部和全文搜索抢地方
       （搜索结果需要宽度）。 -->
  <widget class="QDockWidget" name="outlineDock">
   <property name="windowTitle">
    <string>大纲</string>
   </property>
   <attribute name="dockWidgetArea">
    <number>1</number>
   </attribute>
   <widget class="OutlinePanel" name="outlinePanel"/>
  </widget>
  <!-- 底部停靠面板：全文搜索（可隐藏）。
       搜索结果有"文件 / 行号 / 内容"三列，放在底部而不是左右，宽度更够用。 -->
  <widget class="QDockWidget" name="searchDock">
   <property name="windowTitle">
    <string>全文搜索</string>
   </property>
   <attribute name="dockWidgetArea">
    <number>4</number>
   </attribute>
   <widget class="SearchPanel" name="searchPanel"/>
  </widget>
 </widget>
 <customwidgets>
  <!-- 自定义控件（提升）都写在这里：Designer 只认识 QtWidgets 里的类，
       QWebEngineView 属于 QtWebEngineWidgets 模块，TabManager 属于我们的业务层，
       都得先登记，再用 <widget class="..."> 引用。
       uic 会照这里的 header 生成 #include，所以 ui 目标必须能通过链接找到这些头文件。 -->
  <customwidget>
   <class>QWebEngineView</class>
   <extends>QWidget</extends>
   <header>qwebengineview.h</header>
  </customwidget>
  <!-- extends 写基类（Designer 才知道该按什么来布局）：
       TabManager 继承 QTabWidget；ui 目标链接了 business，所以能找到 tabmanager.h。 -->
  <customwidget>
   <class>TabManager</class>
   <extends>QTabWidget</extends>
   <header>tabmanager.h</header>
  </customwidget>
  <!-- EditorWorkbench 继承 QSplitter，所以 extends 写 QSplitter；header 指向它的头文件。 -->
  <customwidget>
   <class>EditorWorkbench</class>
   <extends>QSplitter</extends>
   <header>editorworkbench.h</header>
  </customwidget>
  <!-- FileTreeView 继承 QTreeView，header 指向 filetreeview.h（同样由 business 提供）。 -->
  <customwidget>
   <class>FileTreeView</class>
   <extends>QTreeView</extends>
   <header>filetreeview.h</header>
  </customwidget>
  <!-- SearchPanel 继承 QWidget，header 指向 searchpanel.h -->
  <customwidget>
   <class>SearchPanel</class>
   <extends>QWidget</extends>
   <header>searchpanel.h</header>
  </customwidget>
  <!-- OutlinePanel 继承 QWidget，header 指向 outlinepanel.h。
       ⚠️ 漏掉这一段登记，uic 就不会生成 #include "outlinepanel.h"，
       编译期会报"未知控件类 OutlinePanel"，而且报错信息完全看不出原因。 -->
  <customwidget>
   <class>OutlinePanel</class>
   <extends>QWidget</extends>
   <header>outlinepanel.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
