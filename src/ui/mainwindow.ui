<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>Markdown 编辑器</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="centralLayout">
    <item>
     <widget class="EditorWorkbench" name="workbench">
      <property name="orientation">
       <enum>Qt::Horizontal</enum>
      </property>
      <property name="childrenCollapsible">
       <bool>false</bool>
      </property>
      <!-- 中央区是一台"工作台"（我们自己的 QSplitter 子类）：左右分屏、三种显示模式、
           以及编辑器与预览之间的双向同步都归它管。.ui 只描述"左边放编辑器容器、
           右边放预览"这个结构，行为都在 EditorWorkbench 里。 -->
      <!-- 左边是多标签管理器（每个标签里是一个 EditorWidget，由 TabManager 在代码里创建）；
           编辑器不在 .ui 里，因为"有几个"是运行期才知道的。 -->
      <widget class="TabManager" name="tabManager">
       <property name="tabsClosable">
        <bool>true</bool>
       </property>
       <property name="movable">
        <bool>true</bool>
       </property>
      </widget>
      <widget class="QWebEngineView" name="preview">
       <property name="url">
        <url>
         <string>about:blank</string>
        </url>
       </property>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar"/>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <customwidgets>
  <!-- 自定义控件（提升）都写在这里：Designer 只认识 QtWidgets 里的类，
       QWebEngineView 属于 QtWebEngineWidgets 模块，TabManager 属于我们的业务层，
       都得先登记，再用 <widget class="..."> 引用。
       uic 会照这里的 header 生成 #include，所以 ui 目标必须能通过链接找到这些头文件。 -->
  <customwidget>
   <class>QWebEngineView</class>
   <extends>QWidget</extends>
   <header>qwebengineview.h</header>
  </customwidget>
  <!-- extends 写基类（Designer 才知道该按什么来布局）：
       TabManager 继承 QTabWidget；ui 目标链接了 business，所以能找到 tabmanager.h。 -->
  <customwidget>
   <class>TabManager</class>
   <extends>QTabWidget</extends>
   <header>tabmanager.h</header>
  </customwidget>
  <!-- EditorWorkbench 继承 QSplitter，所以 extends 写 QSplitter；header 指向它的头文件。 -->
  <customwidget>
   <class>EditorWorkbench</class>
   <extends>QSplitter</extends>
   <header>editorworkbench.h</header>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
</ui>
